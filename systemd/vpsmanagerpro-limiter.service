# Reference unit (regenerated by setup_limiter_service() in the menu).
# The active-user limiter: enforces per-account session limits, expiry,
# kill-switch and per-user bandwidth quotas every 30s.
[Unit]
Description=VPSManagerPRO Active User Limiter
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/vpsmanagerpro-limiter.sh
Restart=always
RestartSec=10
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryHigh=48M
MemoryMax=64M

[Install]
WantedBy=multi-user.target