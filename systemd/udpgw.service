# Reference unit (regenerated by install_udp_custom() in the menu).
# udpgw bridges UDP custom (udp-custom on :36712) to the UDPGW protocol.
[Unit]
Description=VPSManagerPRO UDPGW Backend
After=network.target

[Service]
User=root
Type=simple
ExecStart=/usr/local/bin/udpgw --listen-addr 127.0.0.1:7800 --max-clients 1000 --max-connections-for-client 100
Restart=always
RestartSec=2s

[Install]
WantedBy=multi-user.target