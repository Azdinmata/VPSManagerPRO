# VPSManagerPRO edge TLS stack — nginx default site (reference template).
#
# Deployed by the menu "install_ssl_tunnel" flow (certbot mode) to
# /etc/nginx/sites-available/default. Listeners sit on 127.0.0.1 behind the
# HAProxy edge; HAProxy terminates the public TLS and forwards decrypted TLS
# here on 8443.
#
# Placeholders: __EDGE_DOMAIN__, __EDGE_CERT__, __EDGE_KEY__ (resolved by
# the menu to /etc/vpsmanagerpro/ssl/vpsmanagerpro.crt|.key for self-sign
# mode, or /etc/letsencrypt/live/<domain>/fullchain.pem|privkey.pem for
# certbot mode).

server {
    listen 127.0.0.1:8880 default_server;
    listen 127.0.0.1:8443 ssl http2 default_server;
    server_tokens off;
    server_name __EDGE_DOMAIN__;

    ssl_certificate __EDGE_CERT__;
    ssl_certificate_key __EDGE_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!eNULL:!MD5:!DES:!RC4:!ADH:!SSLv3:!EXP:!PSK:!DSS;
    resolver 1.1.1.1 8.8.8.8 ipv6=off valid=300s;

    # Universal proxy: /<port>/<path> -> http://127.0.0.1:<port>/<path>
    location ~ ^/(?<fwdport>\d+)/(?<fwdpath>.*)$ {
        client_max_body_size 0;
        client_body_timeout 1d;
        grpc_read_timeout 1d;
        grpc_socket_keepalive on;
        proxy_read_timeout 1d;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_socket_keepalive on;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        if ($content_type ~* "GRPC") { grpc_pass grpc://127.0.0.1:$fwdport$is_args$args; break; }
        proxy_pass http://127.0.0.1:$fwdport$is_args$args;
        break;
    }

    # Default location -> Falcon Proxy (WebSockets) frontend on 8080
    location / {
        proxy_read_timeout 3600s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_http_version 1.1;
        proxy_socket_keepalive on;
        tcp_nodelay on;
        tcp_nopush off;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}